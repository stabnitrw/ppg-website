Options -Indexes
# Cegah eksekusi script di folder upload
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php5 .php7 .phar
    RemoveType .php .phtml .php5 .php7 .phar
</IfModule>
